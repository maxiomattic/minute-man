{
  "appId": "org.cvas.app",
  "appName": "Minute Man",
  "webDir": "public",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 800,
      "launchAutoHide": true,
      "backgroundColor": "#0e6b4e",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP"
    },
    "StatusBar": {
      "overlaysWebView": false,
      "style": "DEFAULT"
    },
    "SystemBars": {
      "insetsHandling": "css",
      "style": "DEFAULT",
      "initialViewportFitValueHint": "cover"
    }
  }
}
